{
  "name": "freetoolslab",
  "version": "1.0.0",
  "description": "Free, local-first tools. freetoolslab.org",
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "predev": "node scripts/gen.mjs",
    "dev": "node scripts/serve.mjs . --port 4173",
    "predev:site": "node scripts/gen.mjs",
    "dev:site": "next dev",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs out --port 4173",
    "check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check.mjs",
    "og": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/og.mjs",
    "new": "node scripts/new.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Safar Isaev",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "25.0.6",
    "@types/react": "19.2.8",
    "autoprefixer": "^10.4.23",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3"
  }
