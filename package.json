{
  "name": "freetoolslab",
  "private": true,
  "version": "1.0.0",
  "description": "Free, local-first tools. freetoolslab.org",
  "author": "Safar Isaev",
  "license": "MIT",
  "workspaces": [
    "site"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "predev": "node scripts/gen.mjs",
    "dev": "node scripts/serve.mjs . --port 4173",
    "predev:site": "node scripts/gen.mjs",
    "dev:site": "npm --workspace site run dev",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs site/out --port 4173",
    "check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check.mjs",
    "og": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/og.mjs",
    "record": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/record.mjs",
    "new": "node scripts/new.mjs",
    "typecheck": "npm --workspace site run typecheck",
    "video": "npm --workspace remotion run render --"
  },
  "devDependencies": {
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1"
  }
}
